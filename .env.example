# Nexus Seed — Environment Configuration
# Copy to .env in your sovereign instance. Never commit .env.
# All keys required unless marked OPTIONAL.
# Drive folder IDs: open folder in Google Drive browser, copy the ID from the URL.

# ── Google OAuth ─────────────────────────────────────────────────────────────
# OAuth2 credentials JSON downloaded from Google Cloud Console
# Scopes required: drive, gmail.readonly
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json
# OAuth token cache (auto-created after first browser auth)
GOOGLE_TOKEN_PATH=credentials/google_token.json

# ── Google Drive — Sentinel Stack Folders ────────────────────────────────────
# Root sovereign folder (parent of all folders below)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# 00_inbox  — unprocessed incoming: correspondence, scans, attachments
GOOGLE_DRIVE_INBOX_FOLDER_ID=
# 10_people — care team docs: provider letters, contact records
GOOGLE_DRIVE_PEOPLE_FOLDER_ID=
# 20_matters — matter-specific working folders (one subfolder per matter)
GOOGLE_DRIVE_MATTERS_FOLDER_ID=
# 30_documents — official originals: medical reports, legal, financial
GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID=
# 40_timeline — dated evidence: discharge summaries, dated correspondence
GOOGLE_DRIVE_TIMELINE_FOLDER_ID=
# 50_atlas_journal — synthesis and AI-assisted drafts (not canonical source)
GOOGLE_DRIVE_JOURNAL_FOLDER_ID=
# 90_audit — audit records, evidence packets, receipts
GOOGLE_DRIVE_AUDIT_FOLDER_ID=

# ── Notion (The Den) ──────────────────────────────────────────────────────────
# Integration token from https://www.notion.so/my-integrations
NOTION_TOKEN=
# Root workspace database ID
NOTION_ROOT_DATABASE_ID=
# The Den database ID (sovereign communications holding layer / cauldron)
NOTION_DEN_DATABASE_ID=

# ── AI Provider ──────────────────────────────────────────────────────────────
# Anthropic API key — reasoning, drafting, workflow automation
ANTHROPIC_API_KEY=

# ── Nexus Runtime ────────────────────────────────────────────────────────────
# Unique identifier for this client deployment (no spaces, lowercase)
NEXUS_CLIENT_ID=
# Human-readable display name
NEXUS_CLIENT_NAME=
# Absolute path to sovereign data directory outside the repo
# (active records, exports, caches — never inside the git tree)
NEXUS_DATA_DIR=

# ── Sentinel Stack — Notifications ───────────────────────────────────────────
# OPTIONAL: webhook URL for care team escalation alerts
SENTINEL_WEBHOOK_URL=
# OPTIONAL: care coordinator email for escalation notices
SENTINEL_ALERT_EMAIL=
# OPTIONAL: care recipient email (used for handover package delivery)
SENTINEL_RECIPIENT_EMAIL=
