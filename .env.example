# Nexus Seed — Environment Configuration
# Copy to .env in your sovereign instance. Never commit .env.
# All keys required unless marked OPTIONAL.

# ── Google Drive ────────────────────────────────────────────────────────────
# Path to OAuth2 credentials JSON downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json
# Path where the OAuth token is cached after first auth
GOOGLE_TOKEN_PATH=credentials/google_token.json
# Root folder ID of the client's Google Drive sovereign folder
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Notion ───────────────────────────────────────────────────────────────────
# Integration token from https://www.notion.so/my-integrations
NOTION_TOKEN=
# Root database ID for the client's Notion workspace
NOTION_ROOT_DATABASE_ID=

# ── AI Provider ──────────────────────────────────────────────────────────────
# Anthropic API key — used for workflow automation and care coordination AI
ANTHROPIC_API_KEY=

# ── Nexus Runtime ────────────────────────────────────────────────────────────
# Unique identifier for this client deployment (no spaces, lowercase)
NEXUS_CLIENT_ID=
# Human-readable name for this deployment
NEXUS_CLIENT_NAME=
# Absolute path to the sovereign data directory (outside the repo)
NEXUS_DATA_DIR=

# ── OPTIONAL: Sentinel Stack ──────────────────────────────────────────────────
# Webhook URL for care team notifications (OPTIONAL)
SENTINEL_WEBHOOK_URL=
# Sentinel alert email address (OPTIONAL)
SENTINEL_ALERT_EMAIL=
